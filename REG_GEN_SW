						G10[iCe_G].SETP_PWR_ACT		:=	TRUNC_INT((INT_TO_REAL(GPU_POWER_SETP_N) * INT_TO_REAL(G10[iCe_G].PWR_NOM))/REAL#1000.0) + G10[iCe_G].PWR_DELTA;
						G10[iCe_G].SETP_PWR_ACT_P 	:= 	TRUNC_INT(((INT_TO_REAL(G10[iCe_G].SETP_PWR_ACT) / INT_TO_REAL( G10[iCe_G].PWR_NOM ))*REAL#1000.0));

