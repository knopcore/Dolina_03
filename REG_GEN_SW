				(*Êîððåêòèðóåì óñòàâêó, ÷òîáû îíà áûëà îò 0 äî 100 %*)
				IF (GPU_POWER_SETP_N) > INT#1000	THEN GPU_POWER_SETP_N := INT#1000; 		END_IF;
	        	IF (GPU_POWER_SETP_N) < INT#0	 	THEN GPU_POWER_SETP_N := INT#0; 		END_IF;  
				     
