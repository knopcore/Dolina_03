						G10[iCe_G].SETP_PWR_REACT	:=	- GPU_REACT_SETP_N;
					END_IF;
					
		    END_IF;

		END_FOR;

	END_FOR;



	(*Èíôî, êîãäà âñå îòêëþ÷åíî*)
	FOR iCe_G:=1 TO 4 DO (*G4 CHECK! 3/4*)
		IF G10[iCe_G].ST_GCB_OFF THEN
	
