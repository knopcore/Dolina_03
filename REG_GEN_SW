		(*Ðàñ÷åò ðåàêòèâíîé ìîùíîñòè*)
		FOR iCe_G:=1 TO 4 DO (*G4 CHECK! 3/4*)
			
			IF G10[iCe_G].ST_GCB_ON AND (G10[iCe_G].PWR_GROUP = iCe_L)  THEN
					GPU_REACT_SETP_N			:=	TRUNC_INT(INT_TO_REAL( REACT_AUTO_GENTOT ) * INT_TO_REAL(G10[iCe_G].PWR_NOM )/INT_TO_REAL( POWER_GENTOT_NOM_REACT ));
					
					IF REACT_AUTO_GENTOT > 0 THEN
						G10[iCe_G].SETP_PWR_REACT	:=	  GPU_REACT_SETP_N;
