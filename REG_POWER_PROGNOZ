IF xStart THEN
	
	(*расчет мощностей*)
	POW_PROGNOZ_DOSV1		:= 	0;
	POW_PROGNOZ_DOSV2		:= 	0;
	POWER_NOM_GENTOT		:= 	0;
	POWER_AUTO_GENTOT		:= 	0;

	SETT_PWR_MIN_RES_AUTO	:=	0;
	SETT_PWR_MAX_RES_AUTO	:=	0;

	DOSV_ANY_COMMAND_ON	:= FALSE;
	DOSV_ANY_COMMAND_OFF:= FALSE;
	DOSV_ALL_OFF		:= TRUE;

	(*расчет резервов на включение-отключение досветки*)
	FOR iC1:=1 TO 4 DO  (*G4 CHECK! 3/4*)
		IF G10[iC1].ST_GCB_ON THEN
			POWER_NOM_GENTOT	:= POWER_NOM_GENTOT		+	G10[iC1].PWR_NOM;
			POWER_AUTO_GENTOT	:= POWER_AUTO_GENTOT	+	G10[iC1].PWR_ACT;

			SETT_PWR_MIN_RES_AUTO	:=	SETT_PWR_MIN_RES_AUTO	+	G10[iC1].PWR_ACT_RES;
			SETT_PWR_MAX_RES_AUTO	:=	SETT_PWR_MAX_RES_AUTO	+	TRUNC_INT( INT_TO_REAL(G10[iC1].PWR_NOM) * REAL#0.9) ;
		END_IF;
	END_FOR;
	
	(*для одной машины в работе резервов на включение-отключение досветки меньше*) (* коорректировкаб не в ручном*)
	IF	(NUM_G < 2) AND (POWER_PROGNOZ_TOTAL_DOWN > PWR_L1) AND SETT_GPU_AUTO_ONOFF THEN
		IF SETT_PWR_MIN_RES_AUTO < 900 THEN 
			SETT_PWR_MIN_RES_AUTO := 1000; 
		END_IF;
	END_IF;

	POWER_RESERVE_GENTOT		:=	POWER_NOM_GENTOT	-	POWER_AUTO_GENTOT ;
	IF MODE_PARALLEL THEN  
		POWER_RESERVE_GENTOT 	:= POWER_RESERVE_GENTOT	+ 500 - RU10_RP[1].PWR_ACT; 
	END_IF;

	(*расчет прогноза на включение-отключение досветки, сигналы обобщенные*)
	FOR iC1:=1 TO 21 DO (*по всем командам*)
		FOR iC2	:=	1 TO 120 DO (*по всей нагрузке*)
			IF (LOAD_RP[iC2].ZONE = PRIVA[iC1].ZONE) AND 
			( (PRIVA[iC1].COM_ON OR PRIVA[iC1].ST_ON) OR (LOAD_RP[iC2].ST_ON) ) THEN
				POW_PROGNOZ_DOSV1 := POW_PROGNOZ_DOSV1 + LOAD_RP[iC2].POW_ACT;
			END_IF;
			
			IF (LOAD_RP[iC2].ZONE = PRIVA[iC1].ZONE) AND 
			( (PRIVA[iC1].COM_ON OR (PRIVA[iC1].ST_ON AND NOT PRIVA[iC1].COM_OFF)) (* OR (LOAD_RP[iC2].ST_ON) *) ) THEN
				POW_PROGNOZ_DOSV2 := POW_PROGNOZ_DOSV2 + LOAD_RP[iC2].POW_ACT;
			END_IF;

		END_FOR;

		IF PRIVA[iC1].COM_ON THEN
			DOSV_ANY_COMMAND_ON	:=	TRUE;
		END_IF;

		IF PRIVA[iC1].COM_OFF THEN
			DOSV_ANY_COMMAND_OFF	:=	TRUE;
		END_IF;

		IF PRIVA[iC1].ST_ON THEN
			DOSV_ALL_OFF		:=	FALSE;
		END_IF;
	END_FOR;

	POWER_PROGNOZ_TOTAL_UP 		:= POW_PROGNOZ_DOSV1 + RU04_RP[1].PWR_ACT + RU10_RP[5].PWR_ACT;

	POWER_PROGNOZ_TOTAL_DOWN	:= POW_PROGNOZ_DOSV2 + RU04_RP[1].PWR_ACT + RU10_RP[5].PWR_ACT;

	POWER_LOAD_TOT				:= POWER_AUTO_GENTOT;
	IF MODE_PARALLEL THEN
		POWER_LOAD_TOT			:= RU10_RP[1].PWR_ACT + POWER_LOAD_TOT;
	END_IF;
	
	(*расчет АЧР*)

		IF NOT ACR_FAST_START THEN
			
			TIMER1_GO := TRUE;

			IF TON_1.Q THEN
				FOR iC1:=21 TO 113 BY 1 DO
					DOSV_ACR_1[iC1] 	:= FALSE;	
					DOSV_ACR_2[iC1] 	:= FALSE;
					DOSV_ACR_3[iC1] 	:= FALSE;
					DOSV_ACR_4[iC1] 	:= FALSE; (*G4 CHECK!*)
					DOSV_ACR_GO[iC1] 	:= FALSE;
				END_FOR; 

				TMP_POW1	:=	0;	
				TMP_POW2	:=	0;
				TMP_POW3	:=	0;
				TMP_POW4	:=	0;
			
			
				FOR iC1:=21 TO 113 BY 1 DO
		
					IF (TMP_POW1 < G10[1].PWR_ACT + SETT_PWR_ACR_DELAY ) THEN 
						IF (LOAD_RP[iC1].ST_ON) THEN 
							TMP_POW1 := TMP_POW1 + LOAD_RP[iC1].POW_ACT;
							DOSV_ACR_1[iC1] := TRUE;	
						END_IF;
					END_IF;

					IF (TMP_POW2 < G10[2].PWR_ACT + SETT_PWR_ACR_DELAY ) THEN 
						IF (LOAD_RP[iC1].ST_ON) THEN 
							TMP_POW2 := TMP_POW2 + LOAD_RP[iC1].POW_ACT;
							DOSV_ACR_2[iC1] := TRUE;	
						END_IF;
					END_IF;		
		
					IF (TMP_POW3 < G10[3].PWR_ACT + SETT_PWR_ACR_DELAY ) THEN 
						IF (LOAD_RP[iC1].ST_ON) THEN 
							TMP_POW3 := TMP_POW3 + LOAD_RP[iC1].POW_ACT;
							DOSV_ACR_3[iC1] := TRUE;	
						END_IF;
					END_IF;		
					(*G4 CHECK! begin*)
					IF (TMP_POW4 < G10[4].PWR_ACT + SETT_PWR_ACR_DELAY ) THEN 
						IF (LOAD_RP[iC1].ST_ON) THEN 
							TMP_POW3 := TMP_POW3 + LOAD_RP[iC1].POW_ACT;
							DOSV_ACR_4[iC1] := TRUE;	
						END_IF;
					END_IF;	
					(*G4 CHECK! end*)
		
				END_FOR; 
			
			TIMER1_GO := FALSE;

			END_IF;

		(*перенесено в FAST
		ELSE
			IF G10[1].ST_EMERG_STOP THEN
				FOR iC1:=21 TO 113 BY 1 DO
					DOSV_ACR_GO[iC1]	:= DOSV_ACR_1[iC1];
				END_FOR;
			END_IF;
			IF G10[2].ST_EMERG_STOP THEN
				FOR iC1:=21 TO 113 BY 1 DO
					DOSV_ACR_GO[iC1]	:= DOSV_ACR_2[iC1];
				END_FOR;
			END_IF;
			IF G10[3].ST_EMERG_STOP THEN
				FOR iC1:=21 TO 113 BY 1 DO
					DOSV_ACR_GO[iC1]	:= DOSV_ACR_3[iC1];
				END_FOR;
			END_IF;*)
		END_IF;

ELSE 

	POWER_PROGNOZ_TOTAL_UP	:= 0;

END_IF;

	STATE_NUMBER	:=	99;

	(*добавить всякие отключенные ячейки*)
	R_TRIG_1(CLK:=	SETT_LOAD_AUTO_ONOFF); 	(*если запуск вручную*)
	R_TRIG_2(CLK:= 	DOSV_ANY_COMMAND_ON);	(*если уже в острове и автомате, приходят команды снова*)

	IF R_TRIG_1.Q OR R_TRIG_2.Q OR RESET_ALARM_COM THEN
		IF RU04_RP[3].ST_ON AND RU10_RP[5].ST_ON THEN
			IF (G10[1].ST_GCB_ON OR G10[2].ST_GCB_ON OR G10[3].ST_GCB_ON OR G10[4].ST_GCB_ON) THEN
				ALLOW_LOAD_FROM_GEN	:=	TRUE;
			END_IF;
		ELSE
			IF (G10[1].ST_GCB_ON OR G10[2].ST_GCB_ON OR G10[4].ST_GCB_ON (*G4 CHECK!*)) AND (G04[1].ST_GCB_ON OR G10[3].ST_GCB_ON) THEN 
				ALLOW_LOAD_FROM_GEN	:=	TRUE;
			END_IF;
		END_IF;
		
	END_IF;

	IF RU10_RP[1].ST_ON AND RU10_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON AND RU04_RP[3].ST_ON	  THEN
		STATE_NUMBER	:=	0;
		IF G10[1].ST_GCB_OFF AND G10[2].ST_GCB_OFF AND G10[3].ST_GCB_OFF AND G10[4].ST_GCB_OFF THEN (*G4 CHECK!*)
			ALLOW_LOAD_FROM_GEN	:=	FALSE;
		END_IF;
	END_IF;

	(*расчет номера состояния электроустановки*)
	IF RU10_RP[1].ST_OFF AND RU10_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON AND RU04_RP[3].ST_ON	  THEN
		STATE_NUMBER	:=	1;
	END_IF;

	IF RU10_RP[1].ST_OFF AND RU10_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON AND RU04_RP[3].ST_OFF	  THEN
		STATE_NUMBER	:=	2;
	END_IF;

	IF RU10_RP[1].ST_ON AND RU10_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON AND RU04_RP[3].ST_OFF	  THEN
		STATE_NUMBER	:=	3;
		IF G10[1].ST_GCB_OFF AND G10[2].ST_GCB_OFF AND G10[4].ST_GCB_OFF THEN (*G4 CHECK!*)
			ALLOW_LOAD_FROM_GEN	:=	FALSE;
		END_IF;
	END_IF;

	IF RU10_RP[1].ST_ON AND RU10_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_OFF AND RU04_RP[3].ST_OFF	  THEN
		STATE_NUMBER	:=	4;
	END_IF;

	IF RU10_RP[1].ST_ON AND RU10_RP[3].ST_OFF AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON AND RU04_RP[3].ST_ON	  THEN
		STATE_NUMBER	:=	5;
	END_IF;

	IF RU10_RP[1].ST_ON AND RU10_RP[3].ST_OFF AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON AND RU04_RP[3].ST_OFF	  THEN
		STATE_NUMBER	:=	6;
	END_IF;

	IF RU10_RP[1].ST_ON AND RU10_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_OFF AND RU04_RP[3].ST_ON	  THEN
		STATE_NUMBER	:=	7;
	END_IF;

	(*определение переменных состояния электроустановки, островного режима*)
	MODE_ISLAND 		:= 	FALSE;
	MODE_PARALLEL		:=	TRUE;
	
	IF (G10[1].ST_GCB_ON AND G10[1].MODE_ISLAND) OR (G10[2].ST_GCB_ON AND G10[2].MODE_ISLAND) 
		OR (G10[4].ST_GCB_ON AND G10[4].MODE_ISLAND) (*G4 CHECK!*)
		OR (G10[3].ST_GCB_ON AND G10[3].MODE_ISLAND AND RU04_RP[3].ST_ON AND RU10_RP[5].ST_ON AND RU10_RP[6].ST_ON) THEN
		MODE_ISLAND 		:= 	TRUE;
		MODE_PARALLEL		:=	FALSE;
	END_IF;

	(*расчет уровней генерации для каждой группы машин*)
	PWR_L1	:=	G10[1].PWR_NOM - G10[1].PWR_ACT_RES;
	PWR_L2	:=	G10[2].PWR_NOM - G10[2].PWR_ACT_RES;
	PWR_L3	:=	G10[3].PWR_NOM - G10[3].PWR_ACT_RES;
	PWR_L13	:=	PWR_L1	+	PWR_L3;
	PWR_L23	:=	PWR_L2	+	PWR_L3;
	PWR_L12	:=	PWR_L1	+	PWR_L2;
	PWR_L123:=	PWR_L1	+	PWR_L2	+	PWR_L3;

	PWR_L4	:=	G10[4].PWR_NOM - G10[4].PWR_ACT_RES;  (*G4 CHECK!*)
	PWR_L14	:=	PWR_L1	+	PWR_L4;
	PWR_L1234:=	PWR_L1	+	PWR_L2	+	PWR_L3 	+	PWR_L4;


	TON_1(IN:=TIMER1_GO, PT:=TIME#1000ms);


	IF NUM_G > 1 THEN 
		SETT_T_TO_STEPUP	:=	SETT_T_TO_STEPUP_MUL;
	ELSE
		SETT_T_TO_STEPUP 	:= 	SETT_T_TO_STEPUP_SING;
	END_IF;


